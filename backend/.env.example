NODE_ENV=development
PORT=5000

# Prisma CLI connection URL (migrations/validation)
DATABASE_URL="mysql://scm_user:change-me@127.0.0.1:3306/scm"

# Runtime database connection used by the MariaDB driver adapter
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=scm_user
DB_PASSWORD=change-me
DB_NAME=scm

# Generate a long, random value for every deployed environment.
JWT_SECRET=replace-with-a-long-random-secret

# Exact frontend origin; no path or trailing slash.
FRONTEND_URL=http://localhost:3000

# Optional AI study assistant
GEMINI_API_KEY=

# Required only for admin invitation email delivery
RESEND_API_KEY=
ADMIN_INVITE_FROM="SCM <noreply@example.com>"
