generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  username       String          @unique
  email          String          @unique
  password       String
  role           UserRole        @default(STUDENT)
  isSuperAdmin   Boolean         @default(false)
  sessionVersion Int             @default(0)
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  courses        Course[]
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  @@map("users")
}

model StudentProfile {
  id                      Int          @id @default(autoincrement())
  userId                  Int          @unique
  studentId               String       @unique
  department              String
  year                    String
  phone                   String?      @db.VarChar(255)
  address                 String?      @db.Text
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  assignmentNotifications Boolean      @default(true)
  feeNotifications        Boolean      @default(true)
  gradeNotifications      Boolean      @default(true)
  aiPlan                  String       @default("FREE")
  aiMessagesUsed          Int          @default(0)
  aiUsageResetAt          DateTime     @default(now())
  attendance              Attendance[]
  enrollments             Enrollment[]
  fees                    Fee[]
  grades                  Grade[]
  payments                Payment[]
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions             Submission[]

  @@map("student_profiles")
}

model TeacherProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  department    String
  qualification String
  experience    String
  phone         String?  @db.VarChar(32)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses       Course[] @relation("TeacherCourses")

  @@map("teacher_profiles")
}

model Course {
  id               Int             @id @default(autoincrement())
  code             String          @unique
  name             String
  description      String?         @db.Text
  credits          Float           @default(3.0)
  syllabus         String?         @db.Text
  department       String
  /// Deprecated compatibility column. semesterId/semesterRecord are authoritative.
  semester         String
  semesterId       Int
  status           CourseStatus    @default(ACTIVE)
  teacherId        Int
  teacherProfileId Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  assignments      Assignment[]
  attendance       Attendance[]
  teacher          User            @relation(fields: [teacherId], references: [id])
  teacherProfile   TeacherProfile? @relation("TeacherCourses", fields: [teacherProfileId], references: [id])
  enrollments      Enrollment[]
  grades           Grade[]
  fees             Fee[]
  semesterRecord   Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  @@index([teacherId], map: "courses_teacherId_fkey")
  @@index([teacherProfileId], map: "courses_teacherProfileId_fkey")
  @@index([semesterId], map: "courses_semesterId_fkey")
  @@map("courses")
}

model Semester {
  id            Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(100)
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean  @default(false)
  costPerCredit Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  courses       Course[]
  fees          Fee[]

  @@index([isCurrent])
  @@map("semesters")
}

model Enrollment {
  id         Int              @id @default(autoincrement())
  studentId  Int
  courseId   Int
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fee        Fee?

  @@unique([studentId, courseId])
  @@index([courseId], map: "enrollments_courseId_fkey")
  @@map("enrollments")
}

model Assignment {
  id          Int              @id @default(autoincrement())
  courseId    Int
  title       String
  description String           @db.Text
  dueDate     DateTime
  maxMarks    Float            @default(20)
  status      AssignmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([courseId], map: "assignments_courseId_fkey")
  @@map("assignments")
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  courseId  Int
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, date])
  @@index([courseId], map: "attendance_courseId_fkey")
  @@index([studentId], map: "attendance_studentId_fkey")
  @@map("attendance")
}

model Grade {
  id         Int            @id @default(autoincrement())
  studentId  Int
  courseId   Int
  assignment Float?
  midterm    Float?
  final      Float?
  total      Float
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId], map: "grades_courseId_fkey")
  @@index([studentId], map: "grades_studentId_fkey")
  @@map("grades")
}

model Payment {
  id            Int            @id @default(autoincrement())
  studentId     Int
  feeType       String
  amount        Float
  method        PaymentMethod
  transactionId String?        @unique(map: "transactionId") @db.VarChar(255)
  channel       String?        @db.VarChar(255)
  paymentDate   DateTime       @default(now())
  status        PaymentStatus  @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  feeId         Int?
  fee           Fee?           @relation(fields: [feeId], references: [id])
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId], map: "payments_studentId_fkey")
  @@index([feeId])
  @@map("payments")
}

model Submission {
  id           Int              @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  submittedAt  DateTime         @default(now())
  status       SubmissionStatus @default(SUBMITTED)
  marks        Float?
  feedback     String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  fileName     String?
  fileUrl      String?
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("submissions")
}

model Fee {
  id           Int            @id @default(autoincrement())
  studentId    Int
  courseId     Int?
  semesterId   Int?
  enrollmentId Int?           @unique
  amount       Float
  dueDate      DateTime
  status       FeeStatus      @default(UNPAID)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  feeType      String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course       Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  semester     Semester?      @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  enrollment   Enrollment?    @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([studentId])
  @@index([courseId])
  @@index([semesterId])
  @@map("fees")
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

model AdminInvitation {
  id           String    @id @default(uuid())
  email        String
  tokenHash    String    @unique @db.Char(64)
  invitedBy    Int
  targetUserId Int?
  status       String    @default("PENDING")
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  acceptedAt   DateTime?

  @@index([email, status])
  @@map("admin_invitations")
}

model AdminAccessAudit {
  id        Int      @id @default(autoincrement())
  actorId   Int
  action    String
  email     String
  createdAt DateTime @default(now())

  @@map("admin_access_audit")
}

enum UserStatus {
  ACTIVE
  PENDING
  REJECTED
  INACTIVE
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_BANKING
}

enum FeeStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}
